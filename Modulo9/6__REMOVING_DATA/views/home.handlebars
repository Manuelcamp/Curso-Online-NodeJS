<h1>Usuários Cadastrados:</h1>
<div class="container">
    {{#each users}}
    <div class="item">
        <h2>{{this.name}}</h2>
        <p>{{this.occupation}}</p>
        <a href="/users/{{this.id}}" class="details-btn">Ver detalhes</a>
        <form action="/users/delete/{{this.id}}" method="post">
        <input type="submit" value="Excluir" class="delete"></form>
    </div>
    {{/each}}
</div>